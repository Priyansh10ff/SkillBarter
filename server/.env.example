NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillbarter?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Gmail account with 2FA + app password. Leave empty locally to print emails to the console.
EMAIL_USER=you@gmail.com
EMAIL_PASS=<16-char-app-password>

# Optional TURN relay for video calls behind strict networks
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
