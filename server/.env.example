NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillbarter?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional TURN relay for video calls behind strict networks
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: public DNS for mongodb+srv:// if you see "querySrv ECONNREFUSED"
DNS_SERVERS=
